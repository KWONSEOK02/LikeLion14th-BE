# DB (compose 내부 hostname=mysql)
DB_URL=jdbc:mysql://mysql:3306/likelion
DB_USERNAME=root
DB_PASSWORD=changeme

# Redis (compose 내부 hostname=redis)
REDIS_HOST=redis
REDIS_PORT=6379

# JWT (prod에서 실제 값으로 교체 필수, default 폴백 없음)
JWT_SECRET=please-generate-base64-256bit-key
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=1209600000

# OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://your-domain/api/v1/kakao/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=https://your-domain/api/v1/naver/callback

# Docker Hub
DOCKERHUB_USERNAME=your-dockerhub-id
